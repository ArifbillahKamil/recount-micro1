# Copy this file to `.env` in the project root and fill in your key.
#
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# `.env` is listed in .gitignore and must never be committed.
# A variable already exported in your shell takes precedence over this file.

OPENAI_API_KEY=sk-your-key-here

# Optional. Only needed if you want a different model than the CLI default.
# OPENAI_MODEL=gpt-4o-mini
