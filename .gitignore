*.py[cod]

# Regenerated deterministically by `python3 -m recount.warehouse`.
data/*.db

# runs/ and cassettes/ are intentionally NOT ignored.
#
# runs/ holds the results a claim is made from, plus one trajectory per case per
# system. cassettes/ is what lets a reviewer replay the same run with no API key
# and no cost. Both are evidence, and a report whose evidence is untracked is
# not reproducible. They are text and compress well.

.env
.DS_Store
.venv/
